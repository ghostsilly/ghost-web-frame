<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ghost.frame.modules.user.mapper.UserMapper">

    <resultMap id="BaseResultMap" type="com.ghost.frame.modules.user.entity.User">
            <id property="id" column="id" />
            <result property="nickname" column="nickname" />
            <result property="username" column="username" />
            <result property="password" column="password" />
            <result property="role" column="role" />
            <result property="status" column="status" />
            <result property="deleted" column="deleted" />
            <result property="createdDate" column="created_date" />
            <result property="createdBy" column="created_by" />
            <result property="updatedDate" column="updated_date" />
            <result property="updatedBy" column="updated_by" />
    </resultMap>
    
    <!--
    resultMap可以将查询到的数据映射到对应的Java实体类中
    property: Java实体类的属性名
    column: 数据库表的列名
    -->
    <resultMap id="LoginRequestVO" type="com.ghost.frame.modules.user.vo.LoginRequestVO">
        <id property="id" column="id" />
        <result property="nickname" column="nickname" />
        <result property="username" column="username" />
        <result property="role" column="role" />
    </resultMap>
    
    <!-- 获取用户信息 -->
    <select id="getUserInformation" resultMap="LoginRequestVO">
        select id,nickname,username,role from user 
        <where>
            <if test="userId != null">
                id = #{userId}
            </if>
        </where>
    </select>
    
    <resultMap id="UserPageVO" type="com.ghost.frame.modules.user.vo.UserPageVO">
        <id property="id" column="id" />
        <result property="nickname" column="nickname" />
        <result property="username" column="username" />
        <result property="role" column="role" />
        <result property="status" column="status" />
        <result property="createdTime" column="created_date" />
        <result property="updatedTime" column="updated_date" />
    </resultMap>
    
    <!-- 分页查询用户列表 -->
    <select id="selectUserPage" resultMap="UserPageVO">
        select 
            id,
            nickname,
            username,
            role,
            status,
            created_date,
            updated_date
        from user
        <where>
            <if test="dto.username != null and dto.username != ''">
                username = #{dto.username}
            </if>
            <if test="dto.nickname != null and dto.nickname != ''">
                nickname = #{dto.nickname}
            </if>
            <if test="dto.status != null and dto.status != ''">
                status = #{dto.status}
            </if>
        </where>
        order by updated_date desc
    </select>
</mapper>
